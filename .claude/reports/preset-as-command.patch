+ * 가장 가까이 서 있던 선수를 세우면, "4-4-2로 가자"가 팀을 뒤섞지 않고 각자
+ * 제자리 근처에서 줄을 다시 맞추는 일이 된다.
+ */
+function relayout(starters: TacticAssignment[], layout: readonly BoardPoint[]): void {
+  const remaining = new Set(starters);
+  layout.slice(0, starters.length).forEach((point) => {
+    let nearest: TacticAssignment | null = null;
+    let best = Infinity;
+    for (const a of remaining) {
+      const from = a.point ?? anchorOf(a.position);
+      const d = (from.x - point.x) ** 2 + (from.y - point.y) ** 2;
+      if (d < best) {
+        best = d;
+        nearest = a;
+      }
+    }
+    if (!nearest) return;
