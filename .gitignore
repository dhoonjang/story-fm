node_modules/
dist/
coverage/
*.log
.env
.env.*
.DS_Store

# 빌드 산출물 — Next 빌드 캐시(수십 MB)와 TS 증분 정보. 재생성되므로 커밋하지 않는다.
.next/
# NEXT_DIST_DIR로 갈라 놓은 빌드 디렉터리 전부 (.next-e2e, 검증용 .next-scratchNNNN …)
.next-*/
*.tsbuildinfo
.turbo/
# Next가 생성하는 타입 참조 — routes.d.ts 경로가 마지막에 쓴 빌드 디렉터리를 따라
# 바뀌므로 커밋하면 계속 흔들린다. next dev/build가 다시 만든다.
apps/web/next-env.d.ts

# 테스트 산출물 — Playwright 실행 결과·리포트·트레이스 (E2E_SLOT이 붙인 접미사 포함)
test-results/
test-results-*/
playwright-report/
playwright-report-*/
blob-report/
.playwright-mcp/

# 게임 세이브 — 로컬 플레이 데이터. 커밋·git clean 대상에서 제외해
# 업데이트·브랜치 전환에도 유저 게임이 날아가지 않게 한다.
.data/
*.json.tmp
*.json.bak

# Claude Code 로컬 설정 — 개인 권한·환경은 공유하지 않는다.
# (.claude/launch.json 같은 프로젝트 공용 설정은 커밋한다)
.claude/settings.local.json

# 가명 전환 산출물 — `pnpm pseudonymize --out`이 낸 가명본 시드. 시드에서 언제든
# 다시 나오는 값이고, 전환 시점은 유저가 정하는 결정이라 저장소에 남기지 않는다
# (docs/data/sources.md §7.4).
.pseudonymized/
